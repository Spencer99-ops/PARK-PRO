# Configuration de la base de données
# Pour le développement local avec SQLite, commentez cette ligne
# DATABASE_URL=postgresql://user:password@localhost:5432/parking_db

# Pour la production (Render, Supabase, Neon, etc.)
# DATABASE_URL=postgresql://user:password@host:port/dbname

# Exemple Supabase:
# DATABASE_URL=postgresql://postgres:[PASSWORD]@db.[PROJECT_ID].supabase.co:5432/postgres

# Exemple Neon:
# DATABASE_URL=postgresql://[USER]:[PASSWORD]@ep-[REGION].aws.neon.tech/neondb?sslmode=require
